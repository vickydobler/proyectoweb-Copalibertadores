<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Agregar equipo</title>
    <link rel="stylesheet" href="style.css?v=3">
</head>
<body>

<div class="container">

    <div class="header">
        <h1 class="logo">PuntoCopa</h1>
        <h2 class="subtitulo">Agregar equipo</h2>
    </div>

    <div class="nav">
        <a href="index.php?action=home">Inicio</a>
        <a href="index.php?action=categorias">Volver a equipos</a>
    </div>

    <form method="POST" class="fixture team-form">
        <label>Nombre del equipo</label>
        <input type="text" name="nombre" required>

        <label>País</label>
        <input type="text" name="pais" required>

        <label>Estadio</label>
        <input type="text" name="estadio" required>

        <label>Año de fundación</label>
        <input type="number" name="anio_fundacion" min="0" required>

        <label>Copas Libertadores</label>
        <input type="number" name="copas_libertadores" min="0" value="0" required>

        <label>Director técnico</label>
        <input type="text" name="director_tecnico" required>

        <label>Apodo del club</label>
        <input type="text" name="apodo_club">

        <button type="submit">Guardar equipo</button>
    </form>

</div>

</body>
</html>