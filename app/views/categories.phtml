function inicialesEquipo($nombre) {
    $palabras = explode(' ', trim($nombre));
    $iniciales = '';

    foreach ($palabras as $palabra) {
        if ($palabra !== '') {
            $iniciales .= strtoupper(substr($palabra, 0, 1));
        }
    }

    return substr($iniciales, 0, 3);
}
